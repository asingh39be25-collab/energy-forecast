   "source": [
    "# Download model files from HuggingFace Hub (model repo - free!)\n",
    "from huggingface_hub import hf_hub_download\n",
    "import os\n",
    "os.makedirs('model', exist_ok=True)\n",
    "\n",
    "for f in ['scaler.pkl', 'feature_cols.json', 'lstm_energy.keras']:\n",
    "    hf_hub_download(\n",
    "        repo_id='arshthapar/energy-forecast-model',\n",
    "        filename=f'model/{f}',\n",
    "        local_dir='.'\n",
    "    )\n",
    "    print(f'Downloaded: {f}')"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import json, os, pickle\n",
    "import gradio as gr\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'\n",
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "MODEL_DIR = 'model'\n",
    "_model  = load_model(f'{MODEL_DIR}/lstm_energy.keras')\n",
    "with open(f'{MODEL_DIR}/scaler.pkl', 'rb') as f:\n",
    "    _scaler = pickle.load(f)\n",
    "with open(f'{MODEL_DIR}/feature_cols.json') as f:\n",
    "    meta = json.load(f)\n",
    "\n",
    "LOOKBACK     = meta['lookback']\n",
    "TARGET       = meta['target']\n",
    "FEATURE_COLS = meta['feature_cols']\n",
    "ALL_COLS     = meta['all_cols']\n",
    "\n",
    "def predict_from_df(df):\n",
    "    missing = [c for c in ALL_COLS if c not in df.columns]\n",
    "    if missing:\n",
    "        return None, f'Missing columns: {missing}'\n",
    "    df = df[ALL_COLS].dropna().iloc[-LOOKBACK:]\n",
    "    if len(df) < LOOKBACK:\n",
    "        return None, f'Need {LOOKBACK} rows, got {len(df)}'\n",
    "    scaled = _scaler.transform(df.values)\n",
    "    X = scaled[np.newaxis, ...]\n",
    "    pred_s = _model.predict(X, verbose=0).flatten()[0]\n",
    "    dummy = np.zeros((1, len(ALL_COLS)))\n",
    "    dummy[0, 0] = pred_s\n",
    "    return max(0.0, _scaler.inverse_transform(dummy)[0, 0]), None\n",
    "\n",
    "def predict_csv(file_obj):\n",
    "    if file_obj is None:\n",
    "        return 'Please upload a file.'\n",
    "    path = file_obj.name\n",
    "    df = pd.read_excel(path) if path.endswith('.xlsx') else pd.read_csv(path)\n",
    "    for col in ('timestamp','Timestamp','time','Time'):\n",
    "        if col in df.columns:\n",
    "            df = df.drop(columns=[col])\n",
    "    val, err = predict_from_df(df)\n",
    "    if err: return err\n",
    "    return f'### ⚡ Predicted next-hour energy: **{val:.4f} kWh**'\n",
    "\n",
    "with gr.Blocks(title='⚡ Energy Forecaster') as demo:\n",
    "    gr.Markdown('# ⚡ Household Energy Consumption Forecaster\\nPredicts the **next hour energy usage (kWh)** using LSTM.\\n> MAE: 0.0744 kWh | RMSE: 0.0962 kWh')\n",
    "    with gr.Tab('📁 Upload CSV / Excel'):\n",
    "        gr.Markdown(f'Upload a file with at least **{LOOKBACK} rows** and columns: `{\", \".join(ALL_COLS)}`')\n",
    "        file_in = gr.File(label='Upload .csv or .xlsx', file_types=['.csv', '.xlsx'])\n",
    "        btn = gr.Button('🔮 Predict', variant='primary')\n",
    "        out = gr.Markdown()\n",
    "        btn.click(predict_csv, inputs=file_in, outputs=out)\n",
    "    gr.Markdown('---\\n*LSTM model · Gradio · arshthapar*')\n",
    "\n",
    "demo.launch(share=True)"
   ],
   "execution_count": null,
   "outputs": []
  }
 ]
}"